{
  "name": "swiftheartx",
  "version": "1.0.9",
  "description": "SwiftHeartX Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.swiftheartx.app",
    "productName": "SwiftHeartX",
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SwiftX222",
        "repo": "SpecialOfValue"
      }
    ]
  },
  "devDependencies": {
  "electron": "^28.0.0",
  "electron-builder": "^26.0.0"
},
  "dependencies": {
  "electron-updater": "^6.0.0"
}
}
